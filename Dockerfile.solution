# ─────────────────────────────────────────────────────────────
# URL Shortener Lab - Dockerfile (솔루션)
#
# 수강생 가이드:
#   - 먼저 본인 손으로 Dockerfile을 작성해보세요.
#   - 막히면 이 파일과 비교하면서 학습하세요.
# ─────────────────────────────────────────────────────────────

# 1. 베이스 이미지: 가벼운 Python 3.12 slim
FROM python:3.12-slim

# 2. 비-root 사용자 생성 (보안 모범 사례)
#    컨테이너 안에서 root로 실행하면 호스트 권한 탈취 위험이 있습니다.
RUN useradd -m -u 1000 app

# 3. 작업 디렉터리 설정
WORKDIR /app

# 4. 의존성 먼저 설치 (레이어 캐시 최적화)
#    requirements.txt가 바뀌지 않는 한 이 레이어는 재사용됩니다.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 5. 앱 소스 코드 복사
COPY app/ ./app/

# 6. 비-root 유저로 전환
USER app

# 7. 컨테이너가 listen할 포트 명시 (문서화 목적)
EXPOSE 8000

# 8. 헬스체크 - Docker가 주기적으로 /health 호출하여 컨테이너 상태 확인
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# 9. 실행 명령어
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
